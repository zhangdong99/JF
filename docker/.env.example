# Docker Compose 环境变量（复制为 .env 并填入真实值，.env 不进 Git）
# 注意：database/init/01-create-n8n.sql 中的 n8n_user 密码需与 N8N_DB_PASSWORD 一致
POSTGRES_USER=admin
POSTGRES_PASSWORD=请替换成强密码

N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=请替换成强密码

N8N_ENCRYPTION_KEY=请替换成随机密钥（丢失将无法解密 n8n 已保存的凭据）

GENERIC_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
AI_OFFICE_DATA_ROOT=D:/AI-Office
