{
  "id": "eJz1L4XkW5ggP777",
  "name": "AI-Office 系统清单导入治理平台",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "system-import",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000000",
      "name": "Webhook触发",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "webhookId": "system-import"
    },
    {
      "parameters": {
        "fileSelector": "/files/uploads/*.csv",
        "options": {
          "dataIsBinary": true
        }
      },
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "读取上传目录CSV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 解析上传目录中所有 CSV：清理 BOM、保留来源文件名\nconst out = [];\nlet idx = 0;\nfor (const item of $input.all()) {\n  const buf = await this.helpers.getBinaryDataBuffer(idx, 'data');\n  const text = buf.toString('utf8').replace(/^\\uFEFF/, '');\n  const fileName = item.binary?.data?.fileName || '';\n  const lines = text.split(/\\r?\\n/).filter(l => l.trim());\n  if (!lines.length) { idx++; continue; }\n  const headers = lines[0].split(',').map(h => h.trim());\n  for (const line of lines.slice(1)) {\n    const cells = line.split(',');\n    const row = {};\n    headers.forEach((h, i) => { row[h] = (cells[i] ?? '').trim(); });\n    row['_source_file'] = fileName;\n    out.push({ json: row });\n  }\n  idx++;\n}\nreturn out;"
      },
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "解析CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "code",
              "value": "={{ $json.system_id || $json.code }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "name",
              "value": "={{ $json.system_name || $json.name }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "department",
              "value": "={{ $json.department }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "description",
              "value": "={{ $json.business_function }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "annual_cost",
              "value": "={{ Number($json.annual_cost) || 0 }}",
              "type": "number"
            },
            {
              "id": "f6",
              "name": "status",
              "value": "运行中",
              "type": "string"
            },
            {
              "id": "f7",
              "name": "source_file",
              "value": "={{ $json._source_file }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000004",
      "name": "映射台账字段",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/systems?upsert=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Actor",
              "value": "n8n-import"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000005",
      "name": "写入治理平台",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    }
  ],
  "connections": {
    "Webhook触发": {
      "main": [[{"node": "读取上传目录CSV", "type": "main", "index": 0}]]
    },
    "读取上传目录CSV": {
      "main": [[{"node": "解析CSV", "type": "main", "index": 0}]]
    },
    "解析CSV": {
      "main": [[{"node": "映射台账字段", "type": "main", "index": 0}]]
    },
    "映射台账字段": {
      "main": [[{"node": "写入治理平台", "type": "main", "index": 0}]]
    }
  },
  "settings": {},
  "pinData": {}
}
